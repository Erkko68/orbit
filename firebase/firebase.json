{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "ignore": ["venv", "__pycache__", ".pytest_cache", "tests", "pytest.ini", ".coveragerc", "coverage.xml", "requirements-dev.txt"]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    }
  }
}
