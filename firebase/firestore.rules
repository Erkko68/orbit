rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isMember(spaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
        request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
    }

    function memberDoc(spaceId, uid) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(uid));
    }

    function hasRole(spaceId, uid, roles) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(uid)) &&
        memberDoc(spaceId, uid).data.role in roles;
    }

    function isOwner(spaceId) {
      return hasRole(spaceId, request.auth.uid, ['owner']);
    }

    function isAdminOrOwner(spaceId) {
      return hasRole(spaceId, request.auth.uid, ['owner', 'admin']);
    }

    function isSpaceCreator(spaceId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/spaces/$(spaceId)) &&
         get(/databases/$(database)/documents/spaces/$(spaceId)).data.createdBy == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/spaces/$(spaceId)) &&
         getAfter(/databases/$(database)/documents/spaces/$(spaceId)).data.createdBy == request.auth.uid)
      );
    }

    // Fields set once, on creation, that no later write may change.
    function keepsCreation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt', 'spaceId']);
    }

    // Completing records the caller as who completed it; reopening removes it.
    function completesAsSelf() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedBy'])
        || request.resource.data.get('completedBy', request.auth.uid) == request.auth.uid;
    }

    // 1 to 120 characters after trimming (ADR 0002).
    function isTitle(title) {
      return title is string && title.trim().size() > 0 && title.size() <= 120;
    }

    // users/{uid}: private profile, accessible only by owner
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // spaces/{spaceId}
    match /spaces/{spaceId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      // A new space has its creator as its only member: others join through an invitation (#25).
      allow create: if isAuthenticated()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.accent is int;
      allow update: if isAdminOrOwner(spaceId) && keepsCreation();
      allow delete: if isOwner(spaceId);

      // spaces/{spaceId}/members/{memberId}
      match /members/{memberId} {
        allow read: if isMember(spaceId);
        allow create: if (
          (isSpaceCreator(spaceId) && request.auth.uid == memberId && request.resource.data.role == 'owner') ||
          (isAdminOrOwner(spaceId) && request.resource.data.role in ['admin', 'member'])
        );
        // A member edits their own profile copy and the role stays. An owner or admin sets the role of
        // anyone but the owner to admin or member: nobody becomes owner with an update, ownership moves
        // only through the transfer in #27.
        allow update: if (
          (isMember(spaceId) && request.auth.uid == memberId && request.resource.data.role == resource.data.role) ||
          (isAdminOrOwner(spaceId) && resource.data.role != 'owner' && request.resource.data.role in ['admin', 'member'])
        );
        allow delete: if (
          (isMember(spaceId) && request.auth.uid == memberId && resource.data.role != 'owner') ||
          (isOwner(spaceId) && resource.data.role != 'owner') ||
          (isAdminOrOwner(spaceId) && resource.data.role == 'member')
        );
      }

      // spaces/{spaceId}/items/{itemId}: every member creates, edits and completes any item, since the
      // space shares them. Only its creator, an admin or the owner deletes one (ADR 0002, "Roles").
      match /items/{itemId} {
        allow read: if isMember(spaceId);
        allow create: if isMember(spaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.spaceId == spaceId
          && isTitle(request.resource.data.title)
          && request.resource.data.status == 'open';
        allow update: if isMember(spaceId)
          && keepsCreation()
          && isTitle(request.resource.data.title)
          && request.resource.data.status in ['open', 'done']
          && completesAsSelf();
        allow delete: if isMember(spaceId)
          && (resource.data.createdBy == request.auth.uid || isAdminOrOwner(spaceId));
      }
    }

    // invitations/{code}: an invitation to one space, the document id being the code (ADR 0002).
    // A bearer capability: whoever knows the code reads it by id, nobody lists them across spaces.
    // Joining writes to the space itself and its rules are added with #25.
    match /invitations/{code} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && isAdminOrOwner(resource.data.spaceId);
      allow create: if isAuthenticated()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['spaceId', 'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.keys().hasAll(['spaceId', 'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.spaceId is string
        && isAdminOrOwner(request.resource.data.spaceId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && request.resource.data.revoked == false;
      // Revoking is the only change, and it cannot be undone.
      allow update: if isAuthenticated()
        && isAdminOrOwner(resource.data.spaceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if false;
    }
  }
}
