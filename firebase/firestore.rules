rules_version = '2';

// Firebase deploys this one file and the rules language has no imports, so it is organised by scope: the
// helpers every collection uses come first, and each collection keeps its own helpers inside its match
// block, where they can use the path variables (spaceId, memberId) directly. The roles and what each
// rule checks are in docs/data/security-rules.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ────────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function spacePath(spaceId) {
      return /databases/$(database)/documents/spaces/$(spaceId);
    }

    function validItemCost(spaceId, data) {
      let cost = data.get('modules', {}).get('cost', null);
      let members = get(spacePath(spaceId)).data.memberIds;
      return cost == null || (cost is map
        && cost.keys().hasOnly(['cents', 'paidBy', 'memberIds'])
        && cost.cents is int && cost.cents > 0
        && cost.paidBy in members
        && cost.memberIds is list && cost.memberIds.size() > 0
        && cost.memberIds.hasOnly(members));
    }

    function memberPath(spaceId, uid) {
      return /databases/$(database)/documents/spaces/$(spaceId)/members/$(uid);
    }

    // A display name fits the layouts that show it: DISPLAY_NAME_MAX_LENGTH in the app (#293). Checked only when it
    // is written, so a profile from before the limit keeps working.
    function fitsName() {
      let name = request.resource.data.get('displayName', '');
      return name.size() <= 30 || (resource != null && name == resource.data.get('displayName', ''));
    }

    // The fields an update changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isMember(spaceId) {
      return isAuthenticated() &&
        exists(spacePath(spaceId)) &&
        request.auth.uid in get(spacePath(spaceId)).data.memberIds;
    }

    function hasRole(spaceId, uid, roles) {
      return isAuthenticated() &&
        exists(memberPath(spaceId, uid)) &&
        get(memberPath(spaceId, uid)).data.role in roles;
    }

    function isOwner(spaceId) {
      return hasRole(spaceId, request.auth.uid, ['owner']);
    }

    function isAdminOrOwner(spaceId) {
      return hasRole(spaceId, request.auth.uid, ['owner', 'admin']);
    }

    // Fields set once, on creation, that no later write may change.
    function keepsCreation() {
      return !changedKeys().hasAny(['createdBy', 'createdAt', 'spaceId']);
    }

    // 1 to 120 characters after trimming (ADR 0002).
    function isTitle(title) {
      return title is string && title.trim().size() > 0 && title.size() <= 120;
    }

    // The invitation a joining member names: it invites to this space, is not revoked and has not expired.
    function validInvitation(spaceId, code) {
      let invitation = /databases/$(database)/documents/invitations/$(code);
      return code is string
        && exists(invitation)
        && get(invitation).data.spaceId == spaceId
        && get(invitation).data.revoked == false
        && get(invitation).data.expiresAt > request.time;
    }

    // ── users/{uid}: the private profile, read and written by its owner only ────────────────────────

    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && fitsName();
    }

    // ── spaces/{spaceId} ──────────────────────────────────────────────────────────────────────────

    match /spaces/{spaceId} {

      // A space keeps a name that is not blank and a whole-number colour, whatever an edit changes.
      function hasValidSpaceFields() {
        return request.resource.data.name is string
          && request.resource.data.name.trim().size() > 0
          && request.resource.data.accent is int;
      }

      // Who owns the space changes only through a transfer.
      function keepsOwner() {
        return !changedKeys().hasAny(['ownerId']);
      }

      // Who is in a space changes only through a join, a leave or a removal, each of which writes the
      // matching member document in the same batch. The settings never touch membership.
      function keepsMembers() {
        return !changedKeys().hasAny(['memberIds', 'formerMembers']);
      }

      // The space half of a join (ADR 0002, "Joining"): it appends the caller, and only the caller, to
      // memberIds, and the batch also creates their member document with a valid invitation.
      function joinsSpace() {
        let membership = memberPath(spaceId, request.auth.uid);
        return isAuthenticated()
          && !(request.auth.uid in resource.data.memberIds)
          && changedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && existsAfter(membership)
          && getAfter(membership).data.role == 'member'
          && validInvitation(spaceId, getAfter(membership).data.invitationCode);
      }

      // The space half of leaving (#27): it takes the caller, and only the caller, out of memberIds, and the
      // same batch deletes their member document. The owner cannot (their member document stays). The space
      // keeps the leaver's name in formerMembers, and nobody else's entry changes.
      function leavesSpace() {
        return isAuthenticated()
          && request.auth.uid in resource.data.memberIds
          && changedKeys().hasOnly(['memberIds', 'formerMembers'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.formerMembers.get(request.auth.uid, null) is string
          && request.resource.data.formerMembers.diff(resource.data.get('formerMembers', {})).affectedKeys()
            .hasOnly([request.auth.uid])
          && !existsAfter(memberPath(spaceId, request.auth.uid));
      }

      // The space half of a removal (#264): an owner or admin takes one other member, and only them, out of
      // memberIds, and the same batch deletes that member's document, whose own rule decides who may remove
      // whom. The space keeps the removed name in formerMembers, and nobody else's entry changes.
      function removesMember() {
        let removed = resource.data.memberIds.removeAll(request.resource.data.memberIds);
        return isAdminOrOwner(spaceId)
          && removed.size() == 1
          && !(request.auth.uid in removed)
          && changedKeys().hasOnly(['memberIds', 'formerMembers'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll(removed)
          && request.resource.data.formerMembers.get(removed[0], null) is string
          && request.resource.data.formerMembers.diff(resource.data.get('formerMembers', {})).affectedKeys()
            .hasOnly(removed)
          && !existsAfter(memberPath(spaceId, removed[0]));
      }

      // The space half of a transfer (#27, ADR 0004): it names an admin as ownerId, and the same batch makes
      // them owner and the caller an admin. A plain member is made admin first.
      function transfersOwnership() {
        let newOwner = request.resource.data.ownerId;
        return isOwner(spaceId)
          && changedKeys().hasOnly(['ownerId'])
          && newOwner is string
          && newOwner != request.auth.uid
          && newOwner in resource.data.memberIds
          && get(memberPath(spaceId, newOwner)).data.role == 'admin'
          && getAfter(memberPath(spaceId, newOwner)).data.role == 'owner'
          && getAfter(memberPath(spaceId, request.auth.uid)).data.role == 'admin';
      }

      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      // A new space has its creator as its only member and owner: others join through an invitation (#25).
      allow create: if isAuthenticated()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && hasValidSpaceFields();
      // The settings (an owner or admin), or one half of a join, a leave, a removal or a transfer.
      allow update: if (isAdminOrOwner(spaceId) && keepsCreation() && keepsOwner() && keepsMembers() && hasValidSpaceFields())
        || joinsSpace()
        || leavesSpace()
        || removesMember()
        || transfersOwnership();
      // Deleting leaves the members and items behind, unreadable: isMember needs the space (ADR 0004).
      allow delete: if isOwner(spaceId);

      // ── spaces/{spaceId}/members/{memberId} ─────────────────────────────────────────────────────

      match /members/{memberId} {

        function isSpaceCreator() {
          return isAuthenticated() && (
            (exists(spacePath(spaceId)) && get(spacePath(spaceId)).data.createdBy == request.auth.uid) ||
            (existsAfter(spacePath(spaceId)) && getAfter(spacePath(spaceId)).data.createdBy == request.auth.uid)
          );
        }

        // The member half of a join (ADR 0002, "Joining"): the caller's own document, a plain member, naming a
        // valid invitation to this space, and the same batch adds the caller to memberIds.
        function joinsAsMember() {
          return request.auth.uid == memberId
            && request.resource.data.role == 'member'
            && request.resource.data.keys().hasOnly(['role', 'displayName', 'photoUrl', 'joinedAt', 'invitationCode'])
            && request.resource.data.keys().hasAll(['role', 'displayName', 'joinedAt', 'invitationCode'])
            && request.resource.data.displayName is string
            && request.resource.data.joinedAt == request.time
            && validInvitation(spaceId, request.resource.data.invitationCode)
            && !(request.auth.uid in get(spacePath(spaceId)).data.memberIds)
            && request.auth.uid in getAfter(spacePath(spaceId)).data.memberIds;
        }

        // The invitation a member joined with and when are set once, with the join.
        function keepsJoin() {
          return !changedKeys().hasAny(['invitationCode', 'joinedAt']);
        }

        // The member half of a transfer, which changes nothing but roles: the admin the space now names
        // becomes owner, and the owner becomes an admin. Neither stands alone: each needs the other and the
        // new ownerId.
        function handsOwnership() {
          let ownerId = getAfter(spacePath(spaceId)).data.get('ownerId', request.auth.uid);
          return isOwner(spaceId)
            && changedKeys().hasOnly(['role'])
            && ownerId != request.auth.uid
            && getAfter(memberPath(spaceId, ownerId)).data.role == 'owner'
            && getAfter(memberPath(spaceId, request.auth.uid)).data.role == 'admin'
            && ((memberId == ownerId && resource.data.role == 'admin' && request.resource.data.role == 'owner')
              || (memberId == request.auth.uid && request.resource.data.role == 'admin'));
        }

        // The member half of leaving: the caller's own document, and the same batch takes them out of
        // memberIds. The owner never leaves: they delete the space or hand it over first (ADR 0004).
        function leaves() {
          return request.auth.uid == memberId
            && isMember(spaceId)
            && resource.data.role != 'owner'
            && !(request.auth.uid in getAfter(spacePath(spaceId)).data.memberIds);
        }

        allow read: if isMember(spaceId);
        allow create: if fitsName() && (
          (isSpaceCreator() && request.auth.uid == memberId && request.resource.data.role == 'owner')
          || joinsAsMember()
        );
        // A member edits their own profile copy and the role stays. Only the owner sets the role of anyone
        // else to admin or member: an admin makes no admins. Nobody becomes owner this way: only a transfer does.
        allow update: if fitsName() && keepsJoin() && (
          (isMember(spaceId) && request.auth.uid == memberId && request.resource.data.role == resource.data.role) ||
          (isOwner(spaceId) && resource.data.role != 'owner' && request.resource.data.role in ['admin', 'member']) ||
          handsOwnership()
        );
        // Leaving, the owner removing anyone else, or an admin removing a plain member.
        allow delete: if leaves()
          || (isOwner(spaceId) && resource.data.role != 'owner')
          || (isAdminOrOwner(spaceId) && resource.data.role == 'member');
      }

      // ── spaces/{spaceId}/items/{itemId} ─────────────────────────────────────────────────────────
      // Every member creates, edits and completes any item, since the space shares them. Only its creator,
      // an admin or the owner deletes one (ADR 0002, "Roles").

      match /items/{itemId} {

        function completionBatch() {
          let after = request.resource.data;
          let id = after.get('lastCompletionId', '');
          let path = /databases/$(database)/documents/spaces/$(spaceId)/completions/$(id);
          return id is string && id != '' && after.completionVersion is int
            && !exists(path) && existsAfter(path)
            && getAfter(path).data.itemId == itemId
            && after.get('completionVersion', 0) == resource.data.get('completionVersion', 0) + 1;
        }

        // Money cannot be bypassed by completing the item without its history/expense batch.
        function keepsCostAccounting() {
          let before = resource.data;
          let after = request.resource.data;
          let hasCost = 'cost' in before.get('modules', {});
          // Moving a date alone is an ordinary schedule edit, not a completion.
          let completes = before.status == 'open' && after.status == 'done';
          return (!hasCost || !completes || completionBatch())
            && (!changedKeys().hasAny(['completionVersion', 'lastCompletionId', 'costExpenseId']) || completionBatch());
        }

        // Completing records the caller as who completed it; reopening removes it.
        function completesAsSelf() {
          return !changedKeys().hasAny(['completedBy'])
            || request.resource.data.get('completedBy', request.auth.uid) == request.auth.uid;
        }

        allow read: if isMember(spaceId);
        allow create: if isMember(spaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.spaceId == spaceId
          && isTitle(request.resource.data.title)
          && request.resource.data.status == 'open'
          && validItemCost(spaceId, request.resource.data)
          && !request.resource.data.keys().hasAny(['completionVersion', 'lastCompletionId', 'costExpenseId']);
        allow update: if isMember(spaceId)
          && keepsCreation()
          && isTitle(request.resource.data.title)
          && request.resource.data.status in ['open', 'done']
          && completesAsSelf()
          && keepsCostAccounting()
          && (request.resource.data.get('modules', {}).get('cost', null) == resource.data.get('modules', {}).get('cost', null)
            || validItemCost(spaceId, request.resource.data));
        allow delete: if isMember(spaceId)
          && (resource.data.createdBy == request.auth.uid || isAdminOrOwner(spaceId));
      }

      // ── spaces/{spaceId}/completions/{completionId} ────────────────────────────────────────────
      // The history of an item: who completed it or reopened it, and when. A member adds their own entry, in the
      // batch that marks the item done or open again, or that moves a recurring item to its next date. A reopening has `action: 'reopen'`; a completion has no action.
      // Append-only: reopening keeps the completions, and nobody edits or deletes one.

      match /completions/{completionId} {
        function item(itemId) {
          return /databases/$(database)/documents/spaces/$(spaceId)/items/$(itemId);
        }

        // A recurring item stays open and its schedule moves to a later date (ADR 0011).
        function rollsForward(itemId) {
          let before = get(item(itemId)).data;
          let after = getAfter(item(itemId)).data;
          return after.status == 'open'
            && 'recurrence' in after.modules
            && after.modules.schedule.date > before.modules.schedule.date;
        }

        // A reopening opens a done item; a completion leaves the item done, or rolls a recurring one forward.
        function matchesItem(entry) {
          return entry.get('action', null) == 'reopen'
            ? get(item(entry.itemId)).data.status == 'done' && getAfter(item(entry.itemId)).data.status == 'open'
            : !('action' in entry.keys())
              && (getAfter(item(entry.itemId)).data.status == 'done' || rollsForward(entry.itemId));
        }

        function matchesCost(entry) {
          let before = get(item(entry.itemId)).data;
          let after = getAfter(item(entry.itemId)).data;
          let expenseId = entry.get('expenseId', '');
          let expense = /databases/$(database)/documents/spaces/$(spaceId)/expenses/$(completionId);
          let charged = 'cost' in before.get('modules', {}) && !('costExpenseId' in before);
          let rolls = after.status == 'open';
          return entry.get('action', '') == 'reopen' ? (expenseId == ''
            && after.get('costExpenseId', '') == before.get('costExpenseId', '')
            && after.get('completionVersion', 0) == before.get('completionVersion', 0)
            && after.get('lastCompletionId', '') == before.get('lastCompletionId', '')) :
            ((!charged && expenseId == '') || (charged && expenseId == completionId
              && validItemCost(spaceId, before)
              && !exists(expense) && existsAfter(expense)
              && getAfter(expense).data.itemId == entry.itemId
              && getAfter(expense).data.kind == 'expense'
              && getAfter(expense).data.paidBy == before.modules.cost.paidBy))
            && (!('cost' in before.get('modules', {})) || (before.status == 'open'
              && after.get('completionVersion', 0) == before.get('completionVersion', 0) + 1
              && after.lastCompletionId == completionId))
            && (rolls ? !('costExpenseId' in after) :
              after.get('costExpenseId', '') == (charged ? completionId : before.get('costExpenseId', '')));
        }

        allow read: if isMember(spaceId);
        allow create: if isMember(spaceId)
          && request.resource.data.keys().hasOnly(['itemId', 'completedBy', 'completedAt', 'action', 'expenseId'])
          && request.resource.data.itemId is string
          && request.resource.data.completedBy == request.auth.uid
          && request.resource.data.completedAt == request.time
          && matchesItem(request.resource.data)
          && matchesCost(request.resource.data);
        allow update, delete: if false;
      }

      // ── spaces/{spaceId}/expenses/{expenseId} ──────────────────────────────────────────────────
      // The ledger. Editing and deleting follow the item table: every member edits, only the creator, an
      // admin or the owner deletes. Rules cannot sum a split of any size, so the domain checks that the shares
      // add up, and balances only trust the shares (ADR 0003). A settlement is recorded by who paid it, never in
      // someone else's name: the one who owes is trusted to say they paid, and nobody confirms receiving it.

      match /expenses/{expenseId} {

        function hasValidAllocation(data) {
          let allocation = data.get('customAllocation', {});
          let space = get(/databases/$(database)/documents/spaces/$(spaceId)).data;
          return !('customAllocation' in data) || (allocation is map
            && allocation.size() > 0
            && allocation.values().hasOnly([true, false])
            && allocation.keys().hasAll(data.split.keys())
            && allocation.keys().hasOnly(space.memberIds.concat(space.get('formerMembers', {}).keys()).concat(data.split.keys())));
        }

        function isExpense(data) {
          return isTitle(data.title)
            && data.paidBy is string
            && data.split is map
            && data.split.size() > 0
            && data.date is string
            && data.kind in ['expense', 'settlement']
            && data.get('itemId', '') is string
            && hasValidAllocation(data);
        }

        allow read: if isMember(spaceId);
        allow create: if isMember(spaceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.spaceId == spaceId
          && isExpense(request.resource.data)
          && (request.resource.data.kind != 'settlement' || request.resource.data.paidBy == request.auth.uid);
        allow update: if isMember(spaceId)
          && keepsCreation()
          && !changedKeys().hasAny(['kind', 'itemId'])
          && (resource.data.kind != 'settlement' || !changedKeys().hasAny(['paidBy']))
          && isExpense(request.resource.data);
        allow delete: if isMember(spaceId)
          && (resource.data.createdBy == request.auth.uid || isAdminOrOwner(spaceId));
      }
    }

    // ── invitations/{code} ────────────────────────────────────────────────────────────────────────
    // An invitation to one space, the document id being the code (ADR 0002). A bearer capability: whoever
    // knows the code reads it by id, nobody lists them across spaces. Joining checks it (validInvitation).

    match /invitations/{code} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && isAdminOrOwner(resource.data.spaceId);
      allow create: if isAuthenticated()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['spaceId', 'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.keys().hasAll(['spaceId', 'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.spaceId is string
        && isAdminOrOwner(request.resource.data.spaceId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && request.resource.data.revoked == false;
      // Revoking is the only change, and it cannot be undone.
      allow update: if isAuthenticated()
        && isAdminOrOwner(resource.data.spaceId)
        && changedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if false;
    }
  }
}
