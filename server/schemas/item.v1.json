{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Item proposal, version 1",
  "description": "Something the group shares (a task, a chore, a bill to pay, a shopping list, an event), with only the modules it needs. Nothing is saved until the user confirms it.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Short and specific, in the user's language: what is to be done, not who does it."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Anything the title leaves out. Leave it out when there is nothing to add."
    },
    "modules": {
      "type": "object",
      "description": "The modules the item needs, each at most once. None is fine.",
      "properties": {
        "schedule": {
          "type": "object",
          "description": "When it is due: on date, at time or all day, or any day from date to endDate.",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
              "description": "YYYY-MM-DD: the due date, or the first day of the window. For something that repeats, its next occurrence."
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "HH:mm. Leave it out for all day, and never with endDate."
            },
            "endDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
              "description": "YYYY-MM-DD, after date: due any day until then."
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 1,
              "description": "How long it takes."
            }
          },
          "required": ["date"],
          "additionalProperties": false
        },
        "recurrence": {
          "description": "Repeats the schedule: completing the item moves it to the next occurrence. Only with a schedule. Every day, every n weeks on some weekdays, or every n months on one day.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unit": {"type": "string", "enum": ["day"]},
                "every": {"type": "integer", "minimum": 1, "description": "Every how many days."},
                "until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                  "description": "YYYY-MM-DD, not before the schedule's date: the last day it may fall on. Leave it out when it repeats for good."
                }
              },
              "required": ["unit", "every"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "unit": {"type": "string", "enum": ["week"]},
                "every": {"type": "integer", "minimum": 1, "description": "Every how many weeks."},
                "weekdays": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 1, "maximum": 7},
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "The days of the week it falls on: 1 is Monday, 7 is Sunday."
                },
                "until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                  "description": "YYYY-MM-DD, not before the schedule's date: the last day it may fall on. Leave it out when it repeats for good."
                }
              },
              "required": ["unit", "every", "weekdays"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "unit": {"type": "string", "enum": ["month"]},
                "every": {"type": "integer", "minimum": 1, "description": "Every how many months."},
                "dayOfMonth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31,
                  "description": "The day of the month it falls on. A shorter month uses its last day."
                },
                "until": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                  "description": "YYYY-MM-DD, not before the schedule's date: the last day it may fall on. Leave it out when it repeats for good."
                }
              },
              "required": ["unit", "every", "dayOfMonth"],
              "additionalProperties": false
            }
          ]
        },
        "assignment": {
          "description": "Who has it: members by their handle in the request (m1, m2), or anyone.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {"type": "string", "enum": ["member"]},
                "assignees": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": ["mode", "assignees"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {"type": "string", "enum": ["anyone"]}
              },
              "required": ["mode"],
              "additionalProperties": false
            }
          ]
        },
        "checklist": {
          "type": "object",
          "description": "What the item lists, in order: what to buy, the steps of a chore.",
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "text": {"type": "string", "minLength": 1},
                  "quantity": {"type": "integer", "minimum": 1}
                },
                "required": ["text"],
                "additionalProperties": false
              }
            }
          },
          "required": ["entries"],
          "additionalProperties": false
        },
        "reminder": {
          "type": "object",
          "description": "When to remind whoever has it, in minutes before it is due: 0 at that moment, 60 an hour before, 1440 a day before. Only with a schedule.",
          "properties": {
            "offsetsMinutes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 0}
            }
          },
          "required": ["offsetsMinutes"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["title", "modules"],
  "additionalProperties": false
}
